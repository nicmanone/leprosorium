<h2>Post deatils</h2>
  <br>

   <p>
   <%= @row['content'] %>
   
   <br>
   <br>
   Added at <%= @row['created_date'] %>
   <br>
   <br>
   <h4>Comments</h4>
   </p>
   <form action="/details/<%= @row['id'] %>" method="POST" role="form">
    <textarea name="content" rows="4" class="form-control" placeholder="Type post text here" id="floatingTextarea"></textarea>
    <br>
    <button type="submit" class="btn btn-primary">Add comment</button>
  </form>
  <br>
  <% @comments.each do |comment| %>
    <p>
    <%= comment['content'] %>
    <br>
    <span style="font-size:75%;color:gray"><%= comment['created_date'] %></span>
    </p>
    <hr>
  <% end %>
